# Sunucuda /opt/mezhep/.env olarak oluşturulur (izin: 600, sahibi root). DEPOYA GİRMEZ.
# ------------------------------------------------------------------ site
ALAN_ADI=mezhep.ihyadijital.com
# Ana makinede uygulamanın dinlediği port (yalnızca 127.0.0.1; dolu olanlar: 3100 ykk, 3200 e-Kurban, 3300-3301 Okul Rehberi, 5180, 8001, 8002)
WEB_PORT=3400
# İlk açılışta bu e-postayla yönetici hesabı oluşturulur; geçici şifre /data/gizli/ilk-yonetici.txt dosyasına yazılır.
MZ_ADMIN_EMAIL=
MZ_ADMIN_NAME="Ahmet İshak Demir"
# Let's Encrypt (deploy/sertifika.sh)
SERTIFIKA_DIZINI=/opt/mezhep/letsencrypt
ACME_WEBROOT=/opt/vebides/certbot-www

# ------------------------------------------------------------------ Akaid Asistanı (OpenAI)
# Anahtar yalnızca sunucu sürecinde kullanılır; tarayıcıya, loglara ve veritabanına yazılmaz.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# AI_ENABLED=false asistanların hepsini anahtar silmeden kapatır; AI_HANEFI_ENABLED=false yalnızca Hanefî asistanını
AI_ENABLED=true
AI_HANEFI_ENABLED=true
AI_TIMEOUT_MS=45000
# Görev profilleri: basit sorular düşünmeden, açıklama/kıyas isteyenler düşük düşünmeyle
AI_EFFORT_SIMPLE=none
AI_EFFORT_REASONED=low
AI_MAX_OUTPUT_SIMPLE=400
AI_MAX_OUTPUT_REASONED=1200
# Hanefî asistanı: Türkçe soruyu Arapça arama terimlerine çeviren ön çağrı (effort none)
AI_MAX_OUTPUT_TERMS=200
# Hanefî asistanı üslupları: fetva (kısa, effort none) ve akademik (ayrıntılı, effort low)
AI_MAX_OUTPUT_FETVA=700
AI_MAX_OUTPUT_ACADEMIC=2000
# Kullanıcı başına günlük sınırlar
AI_DAILY_REQUESTS_PER_USER=40
AI_DAILY_TOKENS_PER_USER=120000
# Kullanıcı başına dakikalık istek
AI_RATE_PER_MINUTE=6
# Soru uzunluğu (karakter) ve gönderilen sohbet geçmişi (tur)
AI_MAX_INPUT_CHARS=1500
AI_MAX_HISTORY_TURNS=6
# Aynı anda en çok kaç çağrı (genel / kişi başı)
AI_MAX_CONCURRENT=4
AI_MAX_CONCURRENT_PER_USER=1
# Harcama tavanı (USD). Aylık bütçe dolunca asistan ay sonuna kadar yeni soru almaz. 0 = sınırsız.
AI_MONTHLY_BUDGET_USD=20
AI_TOTAL_BUDGET_USD=0
# Maliyet raporu için birim fiyatlar (USD / 1M token). gpt-6-luna için yayımlanan değerler; OpenAI fiyat sayfasından doğrulayın.
AI_PRICE_INPUT_PER_1M=0.10
AI_PRICE_CACHED_INPUT_PER_1M=0.01
AI_PRICE_OUTPUT_PER_1M=0.50
