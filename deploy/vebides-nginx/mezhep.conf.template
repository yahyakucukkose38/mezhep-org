# Mezhep.Org — aynı sunucudaki vebides nginx'ine eklenir (80/443 o nginx'tedir; vebides dosyalarına dokunulmaz).
# Sunucuda /opt/mezhep/vebides-nginx/site/mezhep.conf olarak üretilir; __…__ alanlarını yayinla.mjs doldurur.
# Uygulama ana makinede yalnızca 127.0.0.1:__WEB_PORT__'te açıktır (vebides nginx'i ana makine ağındadır).

server {
    listen 80;
    server_name __ALAN_ADI__;
    server_tokens off;

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name __ALAN_ADI__;
    server_tokens off;

    ssl_certificate     /etc/nginx/mezhep-letsencrypt/live/__ALAN_ADI__/fullchain.pem;
    ssl_certificate_key /etc/nginx/mezhep-letsencrypt/live/__ALAN_ADI__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # En büyük yükleme: 5 MB görsel
    client_max_body_size 8m;
    client_header_timeout 15s;
    client_body_timeout 60s;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    access_log /var/log/nginx/mezhep.access.log;
    error_log  /var/log/nginx/mezhep.error.log;

    location / {
        proxy_pass http://127.0.0.1:__WEB_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # Üzerine yazılır: istemcinin gönderdiği X-Forwarded-For atılır (hız sınırları IP'ye göre doğru çalışsın).
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        # Asistan yanıtı en çok AI_TIMEOUT_MS (45 sn) sürer
        proxy_read_timeout 90s;
        proxy_send_timeout 60s;
    }
}
